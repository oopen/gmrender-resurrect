# Defaults for gmrender-resurrect, read by the systemd unit
# /usr/lib/systemd/system/gmrender-resurrect.service
#
# This is a systemd EnvironmentFile (not a shell script).

# Friendly name advertised to UPnP control points. Defaults to the short
# hostname (set by the unit), override here if you like.
#UPNP_DEVICE_NAME=Livingroom Player

# Extra command line options passed to gmediarender.
# A stable UUID is recommended if you run several renderers in the same
# network; generate one once with `uuidgen`.
DAEMON_OPTS="--gstout-audiosink=alsasink --gstout-audiodevice=sysdefault --gstout-initial-volume-db=-10"
